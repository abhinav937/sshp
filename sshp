def _remember_topic(topics, seen, name):
    if name not in seen:
        seen.add(name)
        topics.append(name)


def _scan_help_topics(argv):
    """Collect help and topic flags, in argv order.

    `-dh` is a destination named h, the same reading argparse uses, so it
    is not a help request. `-ph` is pull plus help.
    """
    help_requested = False
    topics = []
    seen = set()
    index = 0
    count = len(argv)
    while index < count:
        token = argv[index]
        if token == "--":
            break
        if token in ("-h", "--help"):
            help_requested = True
            index += 1
            continue
        if token.startswith("--"):
            name, separator, _value = token.partition("=")
            topic = LONG_TOPICS.get(name)
            if topic:
                _remember_topic(topics, seen, topic)
            if topic == "dest" and separator == "":
                nxt = argv[index + 1] if index + 1 < count else None
                if nxt is not None and not nxt.startswith("-"):
                    index += 2
                    continue
            index += 1
            continue
        if token.startswith("-") and len(token) > 1:
            exact = EXACT_SHORT.get(token)
            if exact:
                _remember_topic(topics, seen, exact)
                index += 1
                continue
            body = token[1:]
            cursor = 0
            while cursor < len(body):
                char = body[cursor]
                if char == "h":
                    help_requested = True
                    cursor += 1
                    continue
                topic = SINGLE_SHORT.get(char)
                if topic is None:
                    break
                _remember_topic(topics, seen, topic)
                cursor += 1
                if topic == "dest":
                    # Remaining characters are the destination value.
                    if cursor < len(body):
                        break
                    nxt = argv[index + 1] if index + 1 < count else None
                    if nxt is not None and not nxt.startswith("-"):
                        index += 1
                    break
            index += 1
            continue
        index += 1
    return help_requested, topics


def topic_help_request(argv):
    """Return (topic, other primaries) when -h is combined with a flag.

    `sshp -h` alone returns (None, []) so argparse can print the full page.
    A primary flag wins over a modifier: `sshp -p -r -h` is pull help.
    """
    help_requested, topics = _scan_help_topics(argv)
    if not help_requested or not topics:
        return None, []
    primaries = [name for name in topics if name in PRIMARY_TOPICS]
    if primaries:
        return primaries[0], primaries[1:]
    return topics[0], []


def print_topic_help(topic, extras):
    print(TOPIC_HELP[topic].strip())
    if extras:
        print()
        print("Also requested:")
        for name in extras:
            flag = TOPIC_FLAG[name]
            print(f"  sshp {flag} -h")
    print()


def build_parser():
    parser = argparse.ArgumentParser(
        description="SSH File Push Tool - Push and pull files to/from a remote device",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        usage="sshp [options] [files ...]",
        epilog="""
examples:
  sshp --setup                    # setup SSH configuration
  sshp file.txt                   # push a file
  sshp --all                      # push non-hidden files in this directory
  sshp --pull remote.txt          # pull a file from the remote
  sshp -r dir/                    # push or pull a directory
  sshp --test                     # test the connection
  sshp -p -h                      # help for one flag (-l -h, -s -h, ...)
""",
        add_help=False,
    )
    parser.add_argument(
        "-h",
        "--help",
        action="help",
        help="This page, or help for one other flag (sshp -p -h)",
    )
    parser.add_argument("files", nargs="*", help="Files to push or pull")

    config_group = parser.add_argument_group("Configuration")
    config_group.add_argument("--setup", "-s", action="store_true", help="Setup SSH configuration")
    config_group.add_argument("--global-setup", "-gs", action="store_true", help="Setup global config (~/.sshp_config.json)")
    config_group.add_argument("--local-setup", "-ls", action="store_true", help="Setup local config (./.sshp_config.json)")
    config_group.add_argument("--edit", "-e", action="store_true", help="Edit existing configuration")
    config_group.add_argument("--config", "-c", action="store_true", help="Show current configuration")

    action_group = parser.add_argument_group("Actions")
    action_group.add_argument("--pull", "-p", action="store_true", help="Pull files from remote")
    action_group.add_argument("--list", "-l", action="store_true", help="List remote files")
    action_group.add_argument("--test", "-t", action="store_true", help="Test SSH connection")
    action_group.add_argument("--speed-test", "-st", action="store_true", help="Test transfer speed")

    opt_group = parser.add_argument_group("Transfer Options")
    opt_group.add_argument("--all", "-a", action="store_true", help="Push all non-hidden files")
    opt_group.add_argument("--recursive", "-r", action="store_true", help="Recursive transfer")
    opt_group.add_argument("--compress", "-z", action="store_true", help="Enable compression")
    opt_group.add_argument("--dry-run", "-n", action="store_true", help="Dry run (simulation)")
    opt_group.add_argument("--dest", "-d", default=".", help="Destination for pulled files")
    opt_group.add_argument("--verbose", "-v", action="store_true", help="Verbose output")
    opt_group.add_argument("--quiet", "-q", action="store_true", help="Quiet mode (summary only)")
    opt_group.add_argument("--version", action="version", version=f"sshp {VERSION}")
    return parser


def main(argv=None):
    for stream in (sys.stdout, sys.stderr):
        if hasattr(stream, "reconfigure"):
            try:
                stream.reconfigure(line_buffering=True)
            except (OSError, ValueError):
                pass
    if argv is None:
        argv = sys.argv[1:]
    topic, extras = topic_help_request(argv)
    if topic:
        print_topic_help(topic, extras)
        return 0
    args = build_parser().parse_args(argv)
    config, source, path = load_config()
    if args.quiet and config is not None:
        config["quiet_mode"] = True
    quiet = bool(args.quiet or (config or {}).get("quiet_mode"))

    if args.global_setup:
        ok = setup_config(force="global")
    elif args.local_setup:
        ok = setup_config(force="local")
    elif args.setup:
        ok = setup_config()
    elif args.edit:
        ok = edit_config(config, source, path)
    elif args.all:
        files = collect_files(args.recursive)
        if not files:
            ok = True
        else:
            ok = push_files(
                config,
                files,
                args.verbose,
                args.compress,
                args.recursive,
                args.dry_run,
                quiet,
            )
    elif args.list:
        ok = list_remote_files(config)
    elif args.test:
        ok = test_connection(config)
    elif args.speed_test:
        ok = speed_test(config)
    elif args.config:
        show_config(config, source, path)
        ok = True
    elif args.pull:
        ok = pull_files(
            config,
            args.files,
            args.dest,
            args.verbose,
            args.compress,
            args.recursive,
            args.dry_run,
            quiet,
        )
    elif args.files:
        ok = push_files(
            config,
            args.files,
            args.verbose,
            args.compress,
            args.recursive,
            args.dry_run,
            quiet,
        )
    else:
        build_parser().print_help()
        ok = True
    return 0 if ok else 1


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (KeyboardInterrupt, EOFError):
        print("\nInterrupted.")
        sys.exit(130)
